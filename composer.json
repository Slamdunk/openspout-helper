{
    "name": "slam/openspout-helper",
    "description": "PhpSpreadsheet helper to create organized data table",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Filippo Tessarotto",
            "email": "zoeslam@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "~8.5.0 || ~8.6.0",
        "openspout/openspout": "^5.13.0"
    },
    "require-dev": {
        "infection/infection": "^0.35.10",
        "phpoffice/phpspreadsheet": "^5.11.0",
        "phpstan/phpstan": "^2.3.5",
        "phpstan/phpstan-phpunit": "^2.1.2",
        "phpunit/phpunit": "^13.4.7",
        "slam/php-cs-fixer-extensions": "^3.16.0"
    },
    "autoload": {
        "psr-4": {
            "Slam\\OpenspoutHelper\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Slam\\OpenspoutHelper\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
